if  not target then
    return;
end
local now=os.clock();
if ((now-AutoShoot.LastFire)<AutoShoot.Cooldown) then
    return;
end
AutoShoot.LastFire=now;
Fire();
end
);
end

local function StopAutoShoot() if AutoShoot.Conn then
    AutoShoot.Conn:Disconnect();
