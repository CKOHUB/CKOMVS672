local function HasClearLOS(part,origin,params) local size=part.Size;
local offsets={
    Vector3.zero,Vector3.new(size.X/2.1 ,0,0),Vector3.new( -size.X/2.1 ,0,0),Vector3.new(0,size.Y/2.1 ,0),Vector3.new(0, -size.Y/2.1 ,0)
}
;
for _,off in ipairs(offsets) do
    local targetPos=part.CFrame * off ;
    if  not Workspace:Raycast(origin,targetPos-origin ,params) then
        return true;
    end
end
return false;
end

local function GetEquippedGun() local char=player.Character;
if  not char then
    return nil;
end
for _,tool in ipairs(char:GetChildren()) do
    if tool:IsA("Tool") then
        local fire=tool:FindFirstChild("fire");
        local beam=tool:FindFirstChild("showBeam");
        if ((fire and fire:IsA("RemoteEvent")) or (beam and beam:IsA("RemoteEvent"))) then
            return tool;
        end
    end
end
return nil;
end

local function FindTarget() local char=player.Character;
local hrp=char and char:FindFirstChild("HumanoidRootPart") ;
if  not (char and hrp) then
    return nil;
end
if  not AutoShoot.RayParams then
    AutoShoot.RayParams=RaycastParams.new();
    AutoShoot.RayParams.FilterType=Enum.RaycastFilterType.Exclude;
    AutoShoot.RayParams.IgnoreWater=true;
end
local best,bestDist=nil,math.huge;
for _,p in ipairs(Players:GetPlayers()) do
    if ((p~=player) and isEnemy(p) and p.Character) then
        local enemyHum=p.Character:FindFirstChild("Humanoid");
        if (enemyHum and (enemyHum.Health>0)) then
            AutoShoot.RayParams.FilterDescendantsInstances={
                char,p.Character
            }
            ;

            local function checkPart(part) local dist=(part.Position-hrp.Position).Magnitude;
            if ((dist<bestDist) and HasClearLOS(part,hrp.Position,AutoShoot.RayParams)) then
                best,bestDist=part,dist;
            end
        end
        if autoShootAgresivoEnabled then
            for _,part in ipairs(p.Character:GetChildren()) do
                if (part:IsA("BasePart") and (part.Name~="HumanoidRootPart")) then
                    checkPart(part);
                end
            end
        else
            for _,name in ipairs(partesNormales) do
                local part=p.Character:FindFirstChild(name);
                if (part and part:IsA("BasePart")) then
                    checkPart(part);
                end
            end
        end
    end
end
end
return best;
end

local function Fire() local char=player.Character;
local hum=char and char:FindFirstChildOfClass("Humanoid") ;
if  not (char and hum and (hum.Health>0)) then
    return;
end
local arma=GetEquippedGun();
if  not arma then
    return;
end
local target=FindTarget();
if  not (target and target.Parent) then
    getgenv().CKOHUBV2AutoShootTarget=nil;
    return;
end
getgenv().CKOHUBV2AutoShootTarget=target;
AutoShoot.LastFire=os.clock();
pcall(function() arma:Activate();
end
);
task.delay(AutoShoot.HoldExtra,function() if (arma.Parent==char) then
    pcall(function() arma:Deactivate();
end
);
end
end
);
end

local function StartAutoShoot() if AutoShoot.Conn then
    return;
end
AutoShoot.LastFire=0;
AutoShoot.Conn=RunService.Heartbeat:Connect(function() if  not (autoShootNormalEnabled or autoShootAgresivoEnabled) then
    getgenv().CKOHUBV2AutoShootTarget=nil;
    return;
end
